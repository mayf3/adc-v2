# ADC V2 Configuration

# Node environment
NODE_ENV=development

# Server port
ADC_V2_PORT=4100

# Frontend origins (comma-separated)
ADC_V2_FRONTEND_ORIGINS=http://localhost:5173

# Definition bindings JSON — maps scenario keys to svc-workflow definitions
ADC_V2_DEFINITION_BINDINGS_JSON=[{"scenarioKey":"development-delivery","displayName":"研发交付","domainId":"__DOMAIN_UUID__","definitionVersionId":"__DEFINITION_VERSION_UUID__","definitionDigest":"sha256:__REPLACE_ME__"}]

# svc-workflow connection
SVC_WORKFLOW_BASE_URL=http://127.0.0.1:8989
SVC_WORKFLOW_REQUEST_TIMEOUT_MS=35000
SVC_WORKFLOW_MAX_ATTEMPTS=3

# Smoke test (isolated environment only)
SVC_WORKFLOW_SMOKE_CONFIRM=
SVC_WORKFLOW_SMOKE_ACCESS_TOKEN=
SVC_WORKFLOW_SMOKE_DOMAIN_ID=
SVC_WORKFLOW_SMOKE_DEFINITION_VERSION_ID=
SVC_WORKFLOW_SMOKE_TRANSITION_DEFINITION_ID=
